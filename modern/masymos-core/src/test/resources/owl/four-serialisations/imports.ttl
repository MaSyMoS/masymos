@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <http://example.org/importing#> .

<http://example.org/importing> a owl:Ontology ;
    owl:imports <http://10.255.255.1/never-answers.owl> ,
                <./sibling-must-not-be-read.owl> .

ex:LocalClass a owl:Class ;
    rdfs:label "local class" .
