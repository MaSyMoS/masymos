@prefix : <http://biomodels.net/SBO/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://biomodels.net/SBO/> .

<http://biomodels.net/SBO/> rdf:type owl:Ontology ;
                             rdfs:comment "Example ontology for the four-serialisation tests" ;
                             owl:versionInfo "1" .

#################################################################
#    Annotation properties
#################################################################

###  http://biomodels.net/SBO/curatorNote
:curatorNote rdf:type owl:AnnotationProperty ;
             rdfs:label "curator note"@en .


#################################################################
#    Object Properties
#################################################################

###  http://biomodels.net/SBO/has_part
:has_part rdf:type owl:ObjectProperty ;
          rdfs:domain :SBO_0000001 ;
          rdfs:range :SBO_0000003 ;
          rdfs:label "has part"@en .


#################################################################
#    Data properties
#################################################################

###  http://biomodels.net/SBO/priority
:priority rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://biomodels.net/SBO/SBO_0000001
:SBO_0000001 rdf:type owl:Class ;
             owl:disjointWith :SBO_0000003 ;
             rdfs:label "entity"@en .


###  http://biomodels.net/SBO/SBO_0000002
:SBO_0000002 rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :SBO_0000001
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :has_part ;
                                                          owl:someValuesFrom :SBO_0000003
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :SBO_0000001 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :has_part ;
                               owl:someValuesFrom :SBO_0000003
                             ] ;
             rdfs:comment "child comment"@en ;
             rdfs:label "child entity"@en .


###  http://biomodels.net/SBO/SBO_0000003
:SBO_0000003 rdf:type owl:Class ;
             rdfs:label "part entity"@en .


#################################################################
#    Individuals
#################################################################

###  http://biomodels.net/SBO/individual_1
:individual_1 rdf:type owl:NamedIndividual ,
                       :SBO_0000002 ;
              :has_part :individual_2 ;
              :priority "high" .


###  http://biomodels.net/SBO/individual_2
:individual_2 rdf:type owl:NamedIndividual ,
                       :SBO_0000003 .


