@prefix : <http://biomodels.net/SBO/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://biomodels.net/SBO/> a owl:Ontology ;
    rdfs:comment "Example ontology in Turtle" ;
    owl:versionInfo "1" .

:curatorNote a owl:AnnotationProperty ;
    rdfs:label "curator note" .

:has_part a owl:ObjectProperty ;
    rdfs:domain :SBO_0000001 ;
    rdfs:range :SBO_0000003 ;
    rdfs:label "has part" .

:priority a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:SBO_0000001 a owl:Class ;
    rdfs:label "entity" .

:SBO_0000003 a owl:Class ;
    rdfs:label "part entity" .

:SBO_0000002 a owl:Class ;
    rdfs:subClassOf :SBO_0000001 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :has_part ;
            owl:someValuesFrom :SBO_0000003 ] ;
    rdfs:comment "child comment" ;
    rdfs:label "child entity" .

:individual_1 a owl:NamedIndividual , :SBO_0000002 ;
    :has_part :individual_2 ;
    :priority "high" .

:individual_2 a owl:NamedIndividual , :SBO_0000003 .
