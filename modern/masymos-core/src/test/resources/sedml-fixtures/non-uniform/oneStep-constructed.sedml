<?xml version="1.0" encoding="UTF-8"?>
<!--
  DATA-3 fixture, CONSTRUCTED (no third-party one-step document was available).
  Minimal SED-ML Level 1 Version 4 document with a <oneStep> simulation, valid against
  sed-ml-L1-V4.xsd. Element order follows the schema sequence: simulations, models, tasks,
  dataGenerators, outputs; inside dataGenerator listOfVariables comes before math.
  Model source "step.xml" is not shipped on purpose: the parser never dereferences it.
  No <pulse> variant is shipped: neither SED-ML L1 V2/V3/V4 nor the L1 V4 schema defines a
  pulse simulation (KISAO pulse algorithms are uniform-time-course algorithms in L1).
-->
<sedML xmlns="http://sed-ml.org/sed-ml/level1/version4" level="1" version="4">
  <listOfSimulations>
    <oneStep id="sim1" step="0.1">
      <algorithm kisaoID="KISAO:0000019"/>
    </oneStep>
  </listOfSimulations>
  <listOfModels>
    <model id="model1" language="urn:sedml:language:sbml" source="step.xml"/>
  </listOfModels>
  <listOfTasks>
    <task id="task1" modelReference="model1" simulationReference="sim1"/>
  </listOfTasks>
  <listOfDataGenerators>
    <dataGenerator id="dg1" name="S1">
      <listOfVariables>
        <variable id="var1" taskReference="task1" target="/sbml:sbml/sbml:model/sbml:listOfSpecies/sbml:species[@id=&apos;S1&apos;]"/>
      </listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <ci> var1 </ci>
      </math>
    </dataGenerator>
  </listOfDataGenerators>
  <listOfOutputs>
    <report id="report1">
      <listOfDataSets>
        <dataSet id="ds1" label="S1" dataReference="dg1"/>
      </listOfDataSets>
    </report>
  </listOfOutputs>
</sedML>
