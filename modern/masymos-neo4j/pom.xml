<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.masymos</groupId>
    <artifactId>masymos-modern</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>masymos-neo4j</artifactId>
  <name>MaSyMoS Neo4j</name>

  <dependencies>
    <dependency>
      <groupId>org.masymos</groupId>
      <artifactId>masymos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>neo4j</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>external-neo4j-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>require-external-neo4j-password</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <!-- SEC-003: the four systemPropertyVariables below are forwarded as-is, so an
                         unset password reaches the test JVM as the literal text
                         ${masymos.it.neo4j.password} and the lane starts anyway. Fail at validate,
                         by property name, before a test runs. -->
                    <requireProperty>
                      <property>masymos.it.neo4j.password</property>
                      <regex>^(?!\$\{).+$</regex>
                      <regexMessage>The external-neo4j-it lane needs a resolved
                        -Dmasymos.it.neo4j.password; a value that starts with ${ is the unresolved
                        property text, not a password (SEC-003).</regexMessage>
                      <message>The external-neo4j-it lane needs -Dmasymos.it.neo4j.password
                        (SEC-003); without it the property is forwarded as literal text.</message>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <excludes>
                <exclude>**/*ContainersIT.java</exclude>
              </excludes>
              <systemPropertyVariables>
                <masymos.it.neo4j.uri>${masymos.it.neo4j.uri}</masymos.it.neo4j.uri>
                <masymos.it.neo4j.username>${masymos.it.neo4j.username}</masymos.it.neo4j.username>
                <masymos.it.neo4j.password>${masymos.it.neo4j.password}</masymos.it.neo4j.password>
                <masymos.it.neo4j.database>${masymos.it.neo4j.database}</masymos.it.neo4j.database>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>corpus</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/CorpusCoverageContainersIT.java</include>
              </includes>
              <!-- CORP7-4: the lane is the guard for every other corpus claim, so it may not be green
                   without having run. `failIfNoSpecifiedTests` covers a named -Dit.test that matches
                   nothing; `failIfNoTests` covers the include itself matching nothing, which is what a
                   rename of the class would otherwise turn into a silent pass. Both are safe here and
                   only here: this module owns the corpus class, so zero tests can only mean a defect. -->
              <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
              <failIfNoTests>true</failIfNoTests>
              <systemPropertyVariables>
                <masymos.corpus.manifest>${project.basedir}/../../corpus/manifest.tsv</masymos.corpus.manifest>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
