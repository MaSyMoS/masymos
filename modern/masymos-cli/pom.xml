<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.masymos</groupId>
    <artifactId>masymos-modern</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>masymos-cli</artifactId>
  <name>MaSyMoS CLI</name>

  <dependencies>
    <dependency>
      <groupId>org.masymos</groupId>
      <artifactId>masymos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- CLI-1: the CLI is the one artifact a user runs without a build toolchain, so its main
           artifact is a merged, executable jar - `java -jar masymos-cli-<version>.jar`. It replaces
           the thin jar instead of being attached beside it, so the name in the published
           instructions is the name that exists after `mvn verify`.
           ServicesResourceTransformer is not optional: jsbml-core and owlapi-distribution declare
           10+ `META-INF/services` files, each jar with the same path, and plain shade keeps only
           one copy - the parser registration disappears and parsing fails at runtime while the jar
           still starts. minimizeJar is off for the same reason: both libraries resolve classes
           reflectively.
           createDependencyReducedPom is off because it writes an untracked
           `dependency-reduced-pom.xml` into the module directory; the installed pom keeps its
           declared dependencies instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.masymos.cli.MaSyMoSMain</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
